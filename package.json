{
  "name": "@tchain/tcabci-read-js-client",
  "version": "2.7.11",
  "description": "TransferChain Fastest Read Network WebSocket Client",
  "homepage": "https://github.com/TransferChain/tcabci-read-js-client#readme",
  "bugs": {
    "url": "https://github.com/TransferChain/tcabci-read-js-client/issues"
  },
  "license": "Apache-2.0",
  "author": "TransferChain A.G <info@transferchain.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TransferChain/tcabci-read-js-client.git"
  },
  "files": [
    "*.d.ts",
    "constants.js",
    "breaker.js",
    "http.js",
    "block.js",
    "client.js",
    "errors.js",
    "message.js",
    "transaction.js",
    "util.js",
    "websocket.js",
    "websocketOptions.js",
    "bytea.js",
    "validation.js"
  ],
  "type": "module",
  "main": "client.js",
  "types": "client.d.ts",
  "scripts": {
    "format": "oxfmt ./",
    "lint": "oxfmt ./ && oxlint --fix ./",
    "lint:check": "oxfmt --check ./ && oxlint ./",
    "test": "pnpm run test:unit && pnpm run test:security && pnpm run test:types",
    "test:all": "pnpm test",
    "test:coverage": "node --experimental-test-coverage --test test/security.test.js",
    "test:unit": "mocha --timeout 5000 test/errors_test.js test/websocketOptions_test.js test/websocket_test.js",
    "test:security": "node --test test/security.test.js",
    "test:types": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 test/consumer.ts",
    "test:integration": "mocha --timeout 7000 test/client_test.js"
  },
  "dependencies": {
    "cockatiel": "^4.0.0",
    "reconnecting-websocket": "^4.4.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "chai": "^6.2.2",
    "mocha": "^11.8.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.84.0",
    "typescript": "^5.9.3",
    "unit.js": "^2.1.1",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.5.1"
}
